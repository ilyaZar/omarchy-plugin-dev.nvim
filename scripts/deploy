#!/bin/bash
set -euo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
BLUE=$'\033[1;34m'
NC=$'\033[0m'
TERMINAL_WIDTH=120

log_ok() {
  echo -e "${GREEN}[OK] $*${NC}" | fold -s -w "$TERMINAL_WIDTH"
}

log_info() {
  echo -e "${BLUE}[INFO] $*${NC}" | fold -s -w "$TERMINAL_WIDTH"
}

log_error() {
  echo -e "${RED}[ERROR] $*${NC}" | fold -s -w "$TERMINAL_WIDTH" >&2
}

fail() {
  log_error "$*"
  exit 1
}

usage() {
  printf 'Usage: %s [--apply|--dry-run] [--enable-auto] [--enable-first-install] <plugin-root>\n' "$0"
}

apply=false
enable_auto=false
enable_first_install=false
root=""

while (( $# > 0 )); do
  case "$1" in
  --apply)
    apply=true
    ;;
  --dry-run)
    apply=false
    ;;
  --enable-auto)
    enable_auto=true
    ;;
  --enable-first-install)
    enable_first_install=true
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    fail "unknown option: $1"
    ;;
  *)
    [[ -z $root ]] || fail "unexpected argument: $1"
    root="$1"
    ;;
  esac
  shift
done

[[ -n $root ]] || {
  usage >&2
  exit 2
}

JQ=${OMARCHY_PLUGIN_DEV_JQ:-jq}
OMARCHY=${OMARCHY_PLUGIN_DEV_OMARCHY:-omarchy}
RSYNC=${OMARCHY_PLUGIN_DEV_RSYNC:-rsync}
OMARCHY_SHELL=${OMARCHY_PLUGIN_DEV_OMARCHY_SHELL:-omarchy-shell}

for command in "$JQ" "$OMARCHY" "$RSYNC"; do
  command -v "$command" >/dev/null 2>&1 || fail "$command is not executable"
done
if [[ $enable_auto == true || $enable_first_install == true ]]; then
  command -v "$OMARCHY_SHELL" >/dev/null 2>&1 || fail "$OMARCHY_SHELL is not executable"
fi

root=$(realpath -- "$root")
[[ -d $root ]] || fail "plugin root does not exist: $root"
[[ -f $root/manifest.json ]] || fail "manifest.json is missing from $root"

"$OMARCHY" plugin validate "$root"
plugin_id=$("$JQ" -er '.id' "$root/manifest.json") || fail "manifest id is invalid"
[[ $plugin_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $plugin_id != *..* ]] \
  || fail "unsafe plugin id: $plugin_id"

plugins_dir=${OMARCHY_PLUGINS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins}
plugins_dir=$(realpath -m -- "$plugins_dir")
target="$plugins_dir/$plugin_id"
first_install=true
if [[ -e $target || -L $target ]]; then
  first_install=false
fi

enable_if_requested() {
  local should_enable=false
  local discovered=false
  local enabled=false
  local enable_output=""
  local rescanned=false
  local responsive=false

  if [[ $enable_auto == true || ($enable_first_install == true && $first_install == true) ]]; then
    should_enable=true
  fi
  [[ $apply == true && $should_enable == true ]] || return 0

  for (( attempt = 0; attempt < 100; attempt++ )); do
    if "$OMARCHY_SHELL" shell ping >/dev/null 2>&1; then
      responsive=true
      break
    fi
    sleep 0.1
  done
  [[ $responsive == true ]] || fail "omarchy-shell did not become ready"

  for (( attempt = 0; attempt < 100; attempt++ )); do
    if "$OMARCHY_SHELL" shell rescanPlugins >/dev/null 2>&1; then
      rescanned=true
      break
    fi
    sleep 0.1
  done
  [[ $rescanned == true ]] || fail "omarchy-shell did not rescan plugins"

  for (( attempt = 0; attempt < 40; attempt++ )); do
    if "$OMARCHY" plugin list --json 2>/dev/null | "$JQ" -e --arg id "$plugin_id" \
      'any(.[]; .id == $id)' >/dev/null; then
      discovered=true
      break
    fi
    sleep 0.05
  done
  [[ $discovered == true ]] || fail "plugin '$plugin_id' is not known after rescan"
  for (( attempt = 0; attempt < 100; attempt++ )); do
    if enable_output=$("$OMARCHY" plugin enable "$plugin_id" 2>&1); then
      enabled=true
      break
    fi
    sleep 0.1
  done
  [[ $enabled == true ]] || fail "${enable_output:-could not enable plugin '$plugin_id'}"
  printf '%s\n' "$enable_output"
}

if [[ -e $target || -L $target ]]; then
  target_source=$(realpath -- "$target") \
    || fail "installed plugin is a dangling symlink: $target"
  if [[ $target_source == "$root" ]]; then
    if [[ -L $target ]]; then
      log_ok "Installed plugin is linked to the project source"
    else
      log_ok "The project source is the installed plugin"
    fi
    enable_if_requested
    exit 0
  fi
fi

if [[ -L $target ]]; then
  fail "installed plugin is a symlink to another source: $target_source"
fi
if [[ -e $target && ! -d $target ]]; then
  fail "installed plugin path is not a directory: $target"
fi
if [[ -e $target/.git || -L $target/.git ]]; then
  fail "installed plugin is a separate git checkout; refusing to overwrite it: $target"
fi

runtime_root=${XDG_RUNTIME_DIR:-/tmp}
stage=$(mktemp -d "$runtime_root/omarchy-plugin-dev.XXXXXX")
cleanup() {
  rm -rf -- "$stage"
}
trap cleanup EXIT

excludes=(
  --exclude=.git/
  --exclude=.omarchy-plugin-dev/
  --exclude=.sublime/
  --exclude=.luacov
  --exclude=coverage/
)

"$RSYNC" -a "${excludes[@]}" -- "$root/" "$stage/"
"$OMARCHY" plugin validate "$stage"

log_info "Source: $root"
log_info "Target: $target"
if [[ $apply != true ]]; then
  if [[ -d $target ]]; then
    "$RSYNC" -ani --delete "${excludes[@]}" -- "$stage/" "$target/"
  else
    find "$stage" -mindepth 1 -printf 'create %P\n' | sort
  fi
  log_info "Dry run only; pass --apply to synchronize"
  exit 0
fi

mkdir -p -- "$plugins_dir" "$target"
"$RSYNC" -a --delete --delay-updates "${excludes[@]}" -- "$stage/" "$target/"
"$OMARCHY" plugin validate "$target"
log_ok "Deployed $plugin_id"
enable_if_requested
log_info "The build task will restart the Omarchy shell"
