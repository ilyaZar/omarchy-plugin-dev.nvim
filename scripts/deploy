#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/task-logging.sh"

fail() {
  task_log_error "$*"
  exit 1
}

report_failure() {
  local status=$?
  task_log_error "Plugin deployment failed"
  exit "$status"
}
trap report_failure ERR

usage() {
  printf 'Usage: %s [--apply|--dry-run] [--enable-auto] [--enable-first-install] <plugin-root>\n' "$0"
}

apply=false
enable_auto=false
enable_first_install=false
root=""

while (( $# > 0 )); do
  case "$1" in
  --apply)
    apply=true
    ;;
  --dry-run)
    apply=false
    ;;
  --enable-auto)
    enable_auto=true
    ;;
  --enable-first-install)
    enable_first_install=true
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    fail "unknown option: $1"
    ;;
  *)
    [[ -z $root ]] || fail "unexpected argument: $1"
    root="$1"
    ;;
  esac
  shift
done

[[ -n $root ]] || {
  usage >&2
  exit 2
}

JQ=${OMARCHY_PLUGIN_DEV_JQ:-jq}
OMARCHY=${OMARCHY_PLUGIN_DEV_OMARCHY:-omarchy}
RSYNC=${OMARCHY_PLUGIN_DEV_RSYNC:-rsync}
OMARCHY_SHELL=${OMARCHY_PLUGIN_DEV_OMARCHY_SHELL:-omarchy-shell}

for command in "$JQ" "$OMARCHY" "$RSYNC"; do
  command -v "$command" >/dev/null 2>&1 || fail "$command is not executable"
done
if [[ $enable_auto == true || $enable_first_install == true ]]; then
  command -v "$OMARCHY_SHELL" >/dev/null 2>&1 || fail "$OMARCHY_SHELL is not executable"
fi

root=$(realpath -- "$root")
[[ -d $root ]] || fail "plugin root does not exist: $root"
[[ -f $root/manifest.json ]] || fail "manifest.json is missing from $root"

plugin_id=$("$JQ" -er '.id' "$root/manifest.json") || fail "manifest id is invalid"
[[ $plugin_id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $plugin_id != *..* ]] \
  || fail "unsafe plugin id: $plugin_id"

plugins_dir=${OMARCHY_PLUGINS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins}
plugins_dir=$(realpath -m -- "$plugins_dir")
target="$plugins_dir/$plugin_id"
first_install=true
if [[ -e $target || -L $target ]]; then
  first_install=false
fi

enable_if_requested() {
  local should_enable=false
  local discovered=false
  local enabled=false
  local enable_output=""
  local plugin_list_filter="any(.[]; .id == \$id)"
  local rescanned=false
  local responsive=false

  if [[ $enable_auto == true || ($enable_first_install == true && $first_install == true) ]]; then
    should_enable=true
  fi
  [[ $apply == true && $should_enable == true ]] || return 0

  task_log_info "Enabling plugin"
  task_log_context "Plugin: $plugin_id"
  task_log_command "omarchy-shell shell ping"
  for (( attempt = 0; attempt < 100; attempt++ )); do
    if "$OMARCHY_SHELL" shell ping >/dev/null 2>&1; then
      responsive=true
      break
    fi
    sleep 0.1
  done
  [[ $responsive == true ]] || fail "omarchy-shell did not become ready"

  task_log_command "omarchy-shell shell rescanPlugins"
  for (( attempt = 0; attempt < 100; attempt++ )); do
    if "$OMARCHY_SHELL" shell rescanPlugins >/dev/null 2>&1; then
      rescanned=true
      break
    fi
    sleep 0.1
  done
  [[ $rescanned == true ]] || fail "omarchy-shell did not rescan plugins"

  task_log_command "omarchy plugin list --json"
  for (( attempt = 0; attempt < 40; attempt++ )); do
    if "$OMARCHY" plugin list --json 2>/dev/null \
      | "$JQ" -e --arg id "$plugin_id" "$plugin_list_filter" >/dev/null; then
      discovered=true
      break
    fi
    sleep 0.05
  done
  [[ $discovered == true ]] || fail "plugin '$plugin_id' is not known after rescan"

  task_log_command "omarchy plugin enable $plugin_id"
  for (( attempt = 0; attempt < 100; attempt++ )); do
    if enable_output=$("$OMARCHY" plugin enable "$plugin_id" 2>&1); then
      enabled=true
      break
    fi
    sleep 0.1
  done
  if [[ $enabled != true ]]; then
    enable_output=${enable_output:-"could not enable plugin '$plugin_id'"}
    fail "$enable_output"
  fi
  task_log_ok "Enabled plugin: $plugin_id"
}

if [[ -e $target || -L $target ]]; then
  target_source=$(realpath -- "$target") \
    || fail "installed plugin is a dangling symlink: $target"
  if [[ $target_source == "$root" ]]; then
    task_log_info "Preparing validated deployment"
    task_log_context "Project directory: $root"
    task_log_context "Installation directory: $target"
    task_log_command "omarchy plugin validate <project>"
    "$OMARCHY" plugin validate "$root"
    if [[ -L $target ]]; then
      task_log_ok "Project source is linked as the installed plugin; no files copied"
    else
      task_log_ok "Project source is already the installed plugin; no files copied"
    fi
    enable_if_requested
    exit 0
  fi
fi

if [[ -L $target ]]; then
  fail "installed plugin is a symlink to another source: $target_source"
fi
if [[ -e $target && ! -d $target ]]; then
  fail "installed plugin path is not a directory: $target"
fi
if [[ -e $target/.git || -L $target/.git ]]; then
  fail "installed plugin is a separate git checkout; refusing to overwrite it: $target"
fi

runtime_root=${XDG_RUNTIME_DIR:-/tmp}
stage=$(mktemp -d "$runtime_root/omarchy-plugin-dev.XXXXXX")
cleanup() {
  rm -rf -- "$stage"
}
trap cleanup EXIT

excludes=(
  --exclude=.git/
  --exclude=.omarchy-plugin-dev/
  --exclude=.sublime/
  --exclude=.luacov
  --exclude=coverage/
)

task_log_info "Preparing validated deployment"
task_log_context "Project directory: $root"
task_log_context "Staging directory: $stage"
task_log_command "omarchy plugin validate <project>"
"$OMARCHY" plugin validate "$root"
task_log_command "rsync -a <project>/ <staging>/"
"$RSYNC" -a "${excludes[@]}" -- "$root/" "$stage/"
task_log_command "omarchy plugin validate <staging>"
"$OMARCHY" plugin validate "$stage"
task_log_ok "Prepared validated plugin copy"

if [[ $apply != true ]]; then
  task_log_info "Previewing plugin file installation"
  task_log_context "Installation directory: $target"
  if [[ -d $target ]]; then
    task_log_command "rsync -ani --delete <staging>/ <installation>/"
    "$RSYNC" -ani --delete "${excludes[@]}" -- "$stage/" "$target/"
  else
    task_log_context "Installation state: target absent; all staged files would be created"
    find "$stage" -mindepth 1 -printf 'create %P\n' | sort
  fi
  task_log_ok "Dry run complete; no files installed"
  exit 0
fi

task_log_info "Installing plugin files"
task_log_context "Installation directory: $target"
mkdir -p -- "$plugins_dir" "$target"
task_log_command "rsync -a --delete <staging>/ <installation>/"
"$RSYNC" -a --delete --delay-updates "${excludes[@]}" -- "$stage/" "$target/"
task_log_command "omarchy plugin validate <installation>"
"$OMARCHY" plugin validate "$target"
task_log_ok "Installed plugin files: $plugin_id"
enable_if_requested
