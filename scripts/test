#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
test_init=tests/init.lua
case "${1:-}" in
  "") ;;
  --coverage)
    test_init=tests/coverage-init.lua
    mkdir -p coverage
    rm -f coverage/luacov.stats.out coverage/luacov.report.out
    ;;
  *) printf 'Usage: %s [--coverage]\n' "$0" >&2; exit 2 ;;
esac
test_home=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/omarchy-plugin-dev-nvim-test.XXXXXX")
trap 'rm -rf -- "$test_home"' EXIT
export XDG_CONFIG_HOME="$test_home/config"
export XDG_DATA_HOME="$test_home/data"
export XDG_CACHE_HOME="$test_home/cache"
export XDG_STATE_HOME="$test_home/state"
"${NVIM:-nvim}" --clean --headless -u "$test_init" \
  -c "lua dofile('tests/runner.lua')"
if [[ $test_init == tests/coverage-init.lua ]]; then
  test -s coverage/luacov.report.out
fi
./tests/deploy.sh
./tests/restart_shell.sh
./tests/task_wrappers.sh
