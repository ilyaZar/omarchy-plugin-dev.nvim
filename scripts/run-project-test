#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$SCRIPT_DIR/lib/task-logging.sh"

if (( $# == 0 )); then
  task_log_error "Project test command is missing"
  exit 2
fi

command -v "$1" >/dev/null 2>&1 || {
  task_log_error "$1 is not executable"
  exit 1
}

printf -v display '%q ' "$@"
task_log_info "Running project test"
task_log_context "Project directory: $(pwd -P)"
task_log_command "${display% }"
if "$@"; then
  task_log_ok "Project test passed"
else
  status=$?
  task_log_error "Project test failed"
  exit "$status"
fi
